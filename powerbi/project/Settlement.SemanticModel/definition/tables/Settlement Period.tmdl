/// Settlement Period index dimension
table 'Settlement Period'

	/// DERIVED: Period index 1 to 50; index is not a universal local-clock label
	column 'Period'
		dataType: int64
		summarizeBy: none
		sourceColumn: settlement_period
		annotation EvidenceClass = DERIVED

	partition 'Settlement Period' = m
		mode: import
		source =
			let
				Run = Json.Document(File.Contents(DataFolder & "/processed/run.json")),
				Source = if Record.FieldOrDefault(Run, "status", "unknown") <> "success" then error "Latest pipeline run did not succeed. Rebuild validated outputs before refreshing." else Csv.Document(File.Contents(DataFolder & "/processed/periods.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers, {{"settlement_period", Int64.Type}}, "en-GB")
			in
				Typed
